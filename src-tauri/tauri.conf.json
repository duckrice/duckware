{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Duckware",
  "version": "1.3.0",
  "identifier": "com.duckrice.duckware",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Duckware",
        "create": false,
        "width": 740,
        "height": 560,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGNzY0NjNDNTEwNEM4RkQKUldUOXlBUlJQRVoyLzh4R09iS2FSMEpMZjk0YmMxdmxMUDBiQXR6Wms2ZitKbXNEaXppKzNvdkIK",
      "endpoints": [
        "https://github.com/duckrice/duckware/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
